FROM eclipse-temurin:17-jdk
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY source.bundle /tmp/source.bundle
ARG SOURCE_REF=ca4-part1
RUN git clone --branch ${SOURCE_REF} /tmp/source.bundle /source
WORKDIR /source
RUN chmod +x gradlew && ./gradlew --no-daemon :app:bootJar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app/build/libs/app-1.0.0.jar"]
