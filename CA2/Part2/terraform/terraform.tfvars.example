# SSH Keys
ssh_private_key_path = "~/.ssh/id_rsa"
ssh_public_key_path  = "~/.ssh/id_rsa.pub"

# Libvirt Configuration
libvirt_uri       = "qemu:///system"
storage_pool_path = "/var/lib/libvirt/ca2-pool"

